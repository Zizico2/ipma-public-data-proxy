# CLI options take precedence over environment variables.
IPMA_PUBLIC_DATA_PROXY_LISTEN_ADDR=127.0.0.1:50053
IPMA_PUBLIC_DATA_PROXY_UPSTREAM_BASE_URL=https://api.ipma.pt/public-data/
IPMA_PUBLIC_DATA_PROXY_UPSTREAM_TIMEOUT_SECONDS=15
IPMA_PUBLIC_DATA_PROXY_MAX_CONCURRENT_FETCHES=8
IPMA_PUBLIC_DATA_PROXY_MAX_RESPONSE_MIB=32
RUST_LOG=ipma_public_data_proxy=info,ipma_public_data_service=info
